{
  "name": "pocketbook-cloud-skill",
  "version": "0.1.0",
  "description": "Codex skill support scripts for PocketBook Cloud workflows.",
  "type": "module",
  "bin": {
    "pocketbook-cloud": "dist/cli.js"
  },
  "files": [
    "SKILL.md",
    "skills/",
    "agents/",
    "bin/",
    "scripts/",
    "dist/",
    ".codex-plugin/",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LTDigor/pocketbook-cloud-skill.git"
  },
  "bugs": {
    "url": "https://github.com/LTDigor/pocketbook-cloud-skill/issues"
  },
  "homepage": "https://github.com/LTDigor/pocketbook-cloud-skill#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "pocketbook": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "codex-skill",
    "pocketbook"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
