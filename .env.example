POCKETBOOK_BASE_URL=https://cloud.pocketbook.digital

# User-provided auth. POCKETBOOK_LOGIN and POCKETBOOK_USERNAME are aliases.
POCKETBOOK_LOGIN=
POCKETBOOK_USERNAME=
POCKETBOOK_PASSWORD=

# Generated by `npm run pocketbook -- login` or `npm run pocketbook -- refresh-token`.
POCKETBOOK_ACCESS_TOKEN=
POCKETBOOK_REFRESH_TOKEN=

# Optional web client settings. Defaults match the public PocketBook Cloud browser app.
POCKETBOOK_WEB_CLIENT_ID=
POCKETBOOK_WEB_CLIENT_SECRET=

POCKETBOOK_LANGUAGE=

# Optional provider selector when PocketBook returns more than one auth provider.
POCKETBOOK_PROVIDER_ALIAS=
POCKETBOOK_SHOP_ID=

# Optional. Scripts read this file after the local .env and write renewed
# tokens here. If omitted, auth commands write tokens to .env in the current
# skill working directory.
POCKETBOOK_ENV_FILE=

# Preferred for first exploration: paste the Cookie header from an authenticated
# browser request. Do not commit this value.
POCKETBOOK_COOKIE_HEADER=

# Alternative: path to a file containing either a raw Cookie header or JSON:
# { "cookie": "name=value; other=value" }
POCKETBOOK_COOKIE_FILE=
